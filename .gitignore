# Root .gitignore for I-ITSM monorepo

# Backend
backend/target/
backend/*.log
backend/.vscode/
backend/.DS_Store
backend/*.class
backend/.mvn/wrapper/maven-wrapper.jar

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.DS_Store
frontend/*.log

# Documentation build artifacts (if any)
documentation/*.html

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment files (never commit secrets)
.env
.env.local
.env.*.local

# Database
*.db
*.sqlite

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*